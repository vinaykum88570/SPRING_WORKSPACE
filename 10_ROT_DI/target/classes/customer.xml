<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    
	<bean id="addr" class = "com.spring.Address">
		<constructor-arg value="Hyderabad"/>
		<constructor-arg value="Telegana"/>
	</bean>

	<bean id="customer" class="com.spring.Customer">
		<property name="customerOD" value="111"/>
		<property name="customerName" value="Smith"/>
		<property name="address" ref="addr" />
	</bean>

</beans>