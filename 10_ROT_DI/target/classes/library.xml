<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    
	<bean id="book1" class="com.spring.list.Book">
		<constructor-arg value ="101"/>
		<constructor-arg value ="Learn Spring"/>
	</bean>
	<bean id="book2" class="com.spring.list.Book">
		<constructor-arg value ="102"/>
		<constructor-arg value ="Learn Spring Boot"/>
	</bean>
	<bean id="book3" class="com.spring.list.Book">
		<constructor-arg value ="103"/>
		<constructor-arg value ="Learn Spring MVC"/>
	</bean>
	
	<bean id="library" class="com.spring.list.Library">
		<property name="books">
			<list>
				<ref bean="book1"/> 	
					<ref bean="book2"/> 	
						<ref bean="book3"/> 	 
			</list>
		</property>
		
	</bean>
     

</beans>